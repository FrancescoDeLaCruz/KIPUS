// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  transactions Transaction[]
  budgets      Budget[]
  creditCards  CreditCard[]
  savingGoals  SavingGoal[]
}

model Account {
  id           String        @id @default(uuid())
  name         String        // Ej: BCP, BBVA, Efectivo
  type         String        // Ej: Ahorro, Corriente, Credito
  balance      Decimal       @default(0)
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Decimal
  description String
  category    String
  date        DateTime @default(now())
  type        String   // 'INCOME' o 'EXPENSE'
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
}

model Budget {
  id       String  @id @default(uuid())
  category String
  limit    Decimal
  month    Int
  year     Int
  userId   String
  user     User    @relation(fields: [userId], references: [id])
}

model CreditCard {
  id          String   @id @default(uuid())
  name        String   // Ej: Visa BCP, Mastercard Interbank
  creditLimit Decimal  // Línea de crédito total
  closingDay  Int      // Día de corte (ej: 20)
  dueDate     Int      // Día de pago (ej: 5)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model SavingGoal {
  id            String    @id @default(uuid())
  title         String    // Ej: Fondo de emergencia, Viaje
  targetAmount  Decimal   // Meta total a ahorrar
  currentAmount Decimal   @default(0) // Monto actual ahorrado
  deadline      DateTime? // Fecha límite opcional
  userId        String
  user          User      @relation(fields: [userId], references: [id])
}
